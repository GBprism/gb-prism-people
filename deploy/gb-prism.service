[Unit]
Description=GB Prism People & Performance
After=network-online.target
Wants=network-online.target

[Service]
User=gbprism
Group=gbprism
WorkingDirectory=/opt/gb-prism
EnvironmentFile=/etc/gb-prism/env
ExecStart=/usr/bin/node --no-warnings src/server.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gb-prism /opt/gb-prism/config/private

[Install]
WantedBy=multi-user.target
